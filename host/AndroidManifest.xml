<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.olatool.dash"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- Plugin APKs (dev.olatool.dash.plugin.PLUGIN). Only owner-enabled ones are bound. -->
    <queries>
        <intent>
            <action android:name="dev.olatool.dash.plugin.PLUGIN" />
        </intent>
    </queries>

    <application
        android:label="Ola Dash"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name="dev.olatool.dash.MainActivity"
            android:theme="@style/OlaDashTheme"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="oladash" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Home screen: replaces the stock HMI while it is disabled (test/hmi-swap.sh). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Built-in media source. Needs the owner's grant: see docs/plugins.md. -->
        <service
            android:name=".plugin.StockMediaService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
