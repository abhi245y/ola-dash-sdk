// Text the host draws. The family is the host's own: themes cannot ship a font with this
// name (`sim --check` refuses it), so the host's faces are the only ones that can answer.
// Medium (500, the default), Bold (700) and ExtraBold (800) are the only weights it ships
// (tools/subset-host-font.py). Digits are tabular. Importing the files registers them when the
// root is created, so Rust registers nothing, and no registration order is relied on: the
// name is unique, not first.
import "fonts/OlaDashHost-Medium.ttf";
import "fonts/OlaDashHost-Bold.ttf";
import "fonts/OlaDashHost-ExtraBold.ttf";

export component HostText inherits Text {
    font-family: "OlaDash Host";
    font-weight: 500;
}
