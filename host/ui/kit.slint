// Host-only settings controls, styled through LockConfig.
import { LockConfig } from "unlock.slint";
import { HostText } from "hosttext.slint";

export component RailRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback pressed();
    property <color> fill: root.selected ? LockConfig.style.accent : LockConfig.style.key-background;
    property <color> ink: root.selected ? LockConfig.on-accent : LockConfig.style.foreground;
    height: 72px;
    border-radius: 36px;
    border-width: 1px;
    border-color: LockConfig.style.key-border;
    background: touch.pressed ? root.fill.mix(root.ink, 0.15) : root.fill;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.pressed(); }
    HostText {
        x: 24px; width: parent.width - 48px; height: parent.height;
        text: root.label;
        color: root.ink;
        font-size: 26px;
        font-weight: 700;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

export component CloseButton inherits Rectangle {
    callback pressed();
    property <color> fill: LockConfig.style.key-background;
    property <color> ink: LockConfig.style.foreground;
    width: 64px; height: 64px;
    border-radius: 32px;
    border-width: 1px;
    border-color: LockConfig.style.key-border;
    background: touch.pressed ? root.fill.mix(root.ink, 0.15) : root.fill;
    accessible-role: button;
    accessible-label: "Close settings";
    accessible-action-default => { root.pressed(); }
    Path {
        x: 20px; y: 20px; width: 24px; height: 24px;
        viewbox-width: 24; viewbox-height: 24;
        fill: root.ink;
        commands: "M 2 0 L 12 10 L 22 0 L 24 2 L 14 12 L 24 22 L 22 24 L 12 14 L 2 24 L 0 22 L 10 12 L 0 2 Z";
    }
    touch := TouchArea { clicked => { root.pressed(); } }
}

export component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback pressed();
    property <color> fill: root.enabled ? LockConfig.style.accent : LockConfig.style.key-background;
    property <color> ink: root.enabled ? LockConfig.on-accent : LockConfig.style.muted;
    width: 240px; height: 64px;
    border-radius: 32px;
    border-width: root.enabled ? 0px : 1px;
    border-color: LockConfig.style.key-border;
    opacity: root.enabled ? 1 : 0.5;
    background: touch.pressed ? root.fill.mix(root.ink, 0.15) : root.fill;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.pressed(); } }
    HostText {
        width: parent.width; height: parent.height;
        text: root.label;
        color: root.ink;
        font-size: 26px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.pressed(); }
    }
}

export component Pane inherits Rectangle {
    in property <string> title;
    out property <length> body-height: root.height - 88px;
    HostText {
        x: 0px; y: 0px;
        width: parent.width; height: 56px;
        text: root.title;
        color: LockConfig.style.foreground;
        font-size: 40px;
        font-weight: 800;
        vertical-alignment: center;
    }
    Rectangle {
        x: 0px; y: 88px; width: parent.width; height: root.body-height;
        @children
    }
}

export component Choice inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> selected;
    callback chosen(int);
    spacing: 16px;
    height: 64px;
    for option[i] in root.options : Rectangle {
        width: (root.width - (root.options.length - 1) * 16px) / max(1, root.options.length);
        height: 64px;
        border-radius: 32px;
        border-width: 1px;
        border-color: LockConfig.style.key-border;
        property <color> fill: root.selected == i ? LockConfig.style.accent : LockConfig.style.key-background;
        property <color> ink: root.selected == i ? LockConfig.on-accent : LockConfig.style.foreground;
        background: touch.pressed ? self.fill.mix(self.ink, 0.15) : self.fill;
        accessible-role: button;
        accessible-label: option;
        accessible-checkable: true;
        accessible-checked: root.selected == i;
        accessible-action-default => { root.chosen(i); }
        HostText {
            width: parent.width; height: parent.height;
            text: option;
            overflow: elide;
            color: parent.ink;
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        touch := TouchArea { clicked => { root.chosen(i); } }
    }
}
