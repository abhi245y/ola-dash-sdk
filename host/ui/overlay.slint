// Host-owned overlay. Painted after the theme's Dash, so no theme can cover it.
// Top 48 px is the telltale bar; alerts are centred modal cards that also
// swallow touches underneath them. Values come from the host bridge.
import { Vehicle } from "vehicle.slint";
import { UnlockScreen } from "unlock.slint";

export global HostState {
    // 0 none, 1 fall/accident, 2 tow/theft, 3 side stand, 4 steering lock,
    // 5 vehicle fault, 6 low battery.
    in property <int> alert-code: 0;
    in property <bool> side-stand: false;
    in property <bool> fault: false;
    // Debug builds only: values are being injected over the test channel.
    in property <bool> test-mode: false;
    // Host-owned authentication; these are deliberately outside the theme contract.
    // 0 connecting, 1 locked, 2 verifying, 3 waiting for unlock, 4 PARK, 5 DRIVE, 6 charge.
    in property <int> auth-phase: 0;
    in property <int> pin-length: 0;
    in property <int> auth-attempts: -1;
    in property <int> auth-error: 0;
    in property <int> auth-cooldown: 0;
    in property <bool> auth-available: false;
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <color> tint;
    height: 34px;
    min-width: 110px;
    border-radius: 6px;
    background: tint;
    Text {
        text: root.label;
        color: #000000;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component HostOverlay inherits Rectangle {
    callback unlock-key(int);
    property <bool> unlock-visible: HostState.auth-phase != 5 && HostState.auth-phase != 6 && !HostState.test-mode;
    property <bool> keypad-visible: root.unlock-visible && HostState.auth-phase != 4;
    property <string> alert-text: HostState.alert-code == 1 ? "FALL OR ACCIDENT DETECTED"
        : HostState.alert-code == 2 ? "TOW / THEFT ALERT"
        : HostState.alert-code == 3 ? "SIDE STAND DOWN"
        : HostState.alert-code == 4 ? "STEERING LOCK ALERT"
        : HostState.alert-code == 5 ? "VEHICLE FAULT" : "LOW BATTERY";

    if root.unlock-visible : UnlockScreen {
        width: parent.width;
        height: parent.height;
        phase: HostState.auth-phase;
        pin-length: HostState.pin-length;
        attempts: HostState.auth-attempts;
        error: HostState.auth-error;
        cooldown: HostState.auth-cooldown;
        available: HostState.auth-available;
        test-mode: HostState.test-mode;
        side-stand: HostState.side-stand;
        key(key) => { root.unlock-key(key); }
    }
    // Fault (5) and low battery (6) can be tapped away; they come back when the
    // alert changes. Safety alerts (1-4) cannot be dismissed.
    property <int> dismissed: 0;
    property <int> code: HostState.alert-code;
    changed code => {
        if root.code == 0 {
            root.dismissed = 0;
        }
    }

    // Telltale bar, 48 px reserved for the host.
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 48px;
        background: #0a0a0a;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            alignment: start;
            if Vehicle.left-indicator : Chip { label: "LEFT"; tint: #ffb000; }
            if Vehicle.right-indicator : Chip { label: "RIGHT"; tint: #ffb000; }
            if Vehicle.high-beam : Chip { label: "HIGH BEAM"; tint: #3da5ff; }
            if Vehicle.headlight : Chip { label: "HEADLIGHT"; tint: #f2f2f2; }
            if Vehicle.locked : Chip { label: "LOCKED"; tint: #d0d0d0; }
            if Vehicle.ready-to-ride : Chip { label: "READY"; tint: #34c759; }
            if HostState.side-stand : Chip { label: "SIDE STAND"; tint: #ff8a00; }
            if HostState.fault : Chip { label: "FAULT"; tint: #ff3b30; }
            if Vehicle.charging : Chip { label: "CHARGING"; tint: #34c759; }
        }
        if HostState.test-mode : Chip {
            width: 150px;
            x: parent.width - self.width - 16px;
            y: 7px;
            label: "TEST DATA";
            tint: #ff2fd2;
        }
    }

    // Modal alert. Touches under it are absorbed.
    // While entering a PIN or parked, warnings stay visible without trapping the
    // user behind a side-stand modal. Existing ride alerts retain their behavior.
    if root.unlock-visible && HostState.alert-code != 0 : Rectangle {
        x: 32px; y: parent.height - 96px;
        width: parent.width - 64px; height: 64px;
        border-radius: 12px;
        background: #3c1719;
        Text {
            text: root.alert-text;
            color: #ffb9b4;
            font-size: 28px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    if !root.unlock-visible && HostState.alert-code != 0 && HostState.alert-code != root.dismissed : Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: #000000d9;
        TouchArea {
            clicked => {
                if HostState.alert-code >= 5 {
                    root.dismissed = HostState.alert-code;
                }
            }
        }
        Rectangle {
            width: 720px;
            height: 240px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #141414;
            border-color: #ff3b30;
            border-width: 3px;
            border-radius: 16px;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.alert-text;
                color: #ffffff;
                font-size: 38px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }
    }
}
