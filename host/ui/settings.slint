import { Vehicle } from "vehicle.slint";
import { HostState } from "overlay.slint";
import { LockConfig } from "unlock.slint";
import { HostText } from "hosttext.slint";
import { RailRow, CloseButton, Pane, Choice, PillButton, Stepper, Swatches, OptionSwatch } from "kit.slint";
import { ThemeInfo } from "theme-switch.slint";

export struct PluginInfo {
    package: string,
    label: string,
    slots: string,
    enabled: bool,
}

export struct ThemeOptionInfo {
    id: string,
    label: string,
    kind: string,
    values: [string],
    min: int,
    max: int,
    color: color,
    flag: bool,
    number: int,
    text: string,
    selected: int,
    swatches: [OptionSwatch],
}

// Interactive host screen: parked only, enforced by Host in theme_root.rs.
export component SettingsScreen inherits Rectangle {
    callback closed();
    callback set-setting(string, string);
    callback set-option(string, string);
    callback apply-theme(string);
    callback load-plugins();
    callback load-themes();
    callback set-plugin(string, bool);
    in property <[ThemeInfo]> themes;
    in property <[PluginInfo]> plugins;
    in property <[ThemeOptionInfo]> theme-options;
    in-out property <bool> options-open: false;
    in property <string> active-theme;
    in property <bool> clock24: true;
    in-out property <int> selected: 0;
    property <[string]> panes: ["Display", "Theme", "Plugins", "About"];
    property <string> pane: panes[selected];
    in-out property <int> cursor: 0;
    property <string> theme-selection;
    init => {
        root.cursor = root.selected;
        root.theme-selection = root.active-theme;
        if root.pane == "Theme" { root.load-themes(); }
        if root.pane == "Plugins" { root.load-plugins(); }
    }
    changed selected => {
        root.options-open = false;
        if root.pane == "Theme" { root.theme-selection = root.active-theme; root.load-themes(); }
        if root.pane == "Plugins" { root.load-plugins(); }
    }
    public function move(delta: int) {
        root.cursor = max(0, min(root.panes.length - 1, root.cursor + delta));
    }
    public function select() {
        root.selected = root.cursor;
    }
    public function close() { root.closed(); }
    background: LockConfig.style.background;
    TouchArea { }

    Rectangle {
        x: 104px; y: 80px; width: 280px; height: root.height - 160px;
        border-radius: 24px;
        border-width: 1px;
        border-color: LockConfig.style.key-border;
        background: LockConfig.style.key-background;
        for entry[i] in root.panes : RailRow {
            x: 16px; y: 16px + i * 88px; width: parent.width - 32px;
            label: entry;
            selected: root.pane == entry;
            pressed => { root.cursor = i; root.select(); }
        }
    }
    CloseButton {
        x: root.width - 168px; y: 80px;
        pressed => { root.close(); }
    }
    if root.pane == "Display" : Pane {
        x: 432px; y: 88px; width: root.width - 640px; height: root.height - 248px;
        title: "Display";
        Rectangle {
            x: 0px; y: 0px; width: parent.width; height: parent.body-height;
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 64px;
                HostText {
                    x: 0px; y: 0px; width: parent.width - 444px; height: parent.height;
                    text: "Night mode";
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Choice {
                    x: parent.width - self.width; y: 0px; width: 420px;
                    options: ["Off", "On", "Auto"];
                    selected: HostState.night-mode;
                    chosen(index) => { root.set-setting("night", index == 0 ? "off" : index == 1 ? "on" : "auto"); }
                }
            }
            if HostState.night-mode == 2 : Rectangle {
                x: 0px; y: 96px; width: parent.width; height: 64px;
                HostText {
                    x: 0px; y: 0px; width: parent.width - 444px; height: parent.height;
                    text: "Night from";
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Stepper {
                    x: parent.width - self.width; y: 0px; width: 420px;
                    label: "Night from";
                    value: HostState.night-start-text;
                    stepped(delta) => { root.set-setting("night-start", Math.mod(HostState.night-start + delta * 15 + 1440, 1440) + ""); }
                }
            }
            if HostState.night-mode == 2 : Rectangle {
                x: 0px; y: 192px; width: parent.width; height: 64px;
                HostText {
                    x: 0px; y: 0px; width: parent.width - 444px; height: parent.height;
                    text: "Night until";
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Stepper {
                    x: parent.width - self.width; y: 0px; width: 420px;
                    label: "Night until";
                    value: HostState.night-end-text;
                    stepped(delta) => { root.set-setting("night-end", Math.mod(HostState.night-end + delta * 15 + 1440, 1440) + ""); }
                }
            }
            if HostState.night-mode == 2 && !HostState.clock-trusted : HostText {
                x: 0px; y: 272px; width: parent.width; height: 24px;
                text: "Automatic time off, using day";
                color: LockConfig.style.muted;
                font-size: 18px;
            }
            Rectangle {
                x: 0px;
                y: HostState.night-mode == 2 ? (HostState.clock-trusted ? 288px : 328px) : 96px;
                width: parent.width; height: 64px;
                HostText {
                    x: 0px; y: 0px; width: parent.width - 384px; height: parent.height;
                    text: "Clock";
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Choice {
                    x: parent.width - self.width; y: 0px; width: 420px;
                    options: ["24-hour", "12-hour"];
                    selected: root.clock24 ? 0 : 1;
                    chosen(index) => { root.set-setting("clock24", index == 0 ? "true" : "false"); }
                }
            }
        }
    }
    if root.pane == "Theme" : Pane {
        x: 432px; y: 88px; width: root.width - 640px; height: root.height - 248px;
        title: "Theme";
        if !root.options-open : Flickable {
            x: 0px; y: 0px; width: parent.width; height: parent.body-height - 88px;
            content-width: self.width;
            content-height: max(self.height, root.themes.length * 112px - 16px);
            for theme[i] in root.themes : Rectangle {
                x: 0px; y: i * 112px; width: parent.width; height: 96px;
                border-radius: 24px;
                border-width: 1px;
                border-color: LockConfig.style.key-border;
                property <bool> selected: root.theme-selection == theme.id;
                property <color> ink: self.selected ? LockConfig.on-accent : LockConfig.style.foreground;
                property <color> secondary: self.selected ? LockConfig.on-accent : LockConfig.style.muted;
                property <bool> has-tag: theme.id == root.active-theme || theme.source == "sideloaded";
                property <length> text-width: self.width - 168px - (self.has-tag ? 168px : 24px);
                background: self.selected ? LockConfig.style.accent : LockConfig.style.key-background;
                accessible-role: button;
                accessible-label: theme.name;
                accessible-checkable: true;
                accessible-checked: self.selected;
                accessible-action-default => { root.theme-selection = theme.id; }
                Rectangle {
                    x: 24px; y: (parent.height - self.height) / 2; width: 128px; height: 77px;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: LockConfig.style.key-border;
                    background: LockConfig.style.key-border.with-alpha(0.5);
                    clip: true;
                    if theme.preview.width > 0 : Image {
                        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                        source: theme.preview;
                        image-fit: cover;
                    }
                }
                HostText {
                    x: 168px; y: 16px; width: parent.text-width; height: 32px;
                    text: theme.name;
                    color: parent.ink;
                    font-size: 26px;
                    font-weight: 700;
                    overflow: elide;
                }
                HostText {
                    x: 168px; y: 52px; width: parent.text-width; height: 24px;
                    text: theme.description;
                    color: parent.secondary;
                    font-size: 18px;
                    overflow: elide;
                }
                if theme.id == root.active-theme || theme.source == "sideloaded" : HostText {
                    x: parent.width - 152px; y: 0px; width: 128px; height: parent.height;
                    text: theme.id == root.active-theme ? "In use" : "Sideloaded";
                    color: parent.secondary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.theme-selection = theme.id; } }
            }
        }
        if root.options-open : Flickable {
            x: 0px; y: 0px; width: parent.width; height: parent.body-height - 88px;
            content-width: self.width;
            content-height: max(self.height, root.theme-options.length * 96px - 16px);
            for option[i] in root.theme-options : Rectangle {
                x: 0px; y: i * 96px; width: parent.width; height: 80px;
                border-radius: 24px;
                border-width: 1px;
                border-color: LockConfig.style.key-border;
                background: LockConfig.style.key-background;
                property <length> control-width: option.kind == "color" ? max(0, option.swatches.length - 1) * 60px + 64px
                    : option.kind == "bool" ? 200px
                    : option.kind == "choice" && option.values.length <= 4 ? min(420px, option.values.length * 96px + (option.values.length - 1) * 16px)
                    : 256px;
                HostText {
                    x: 24px; y: 0px; width: parent.width - parent.control-width - 48px; height: parent.height;
                    text: option.label;
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if option.kind == "bool" : Choice {
                    x: parent.width - self.width - 24px; y: 8px; width: 200px;
                    options: ["Off", "On"];
                    selected: option.flag ? 1 : 0;
                    chosen(index) => { root.set-option(option.id, index == 1 ? "true" : "false"); }
                }
                if option.kind == "choice" && option.values.length <= 4 : Choice {
                    x: parent.width - self.width - 24px; y: 8px; width: parent.control-width;
                    options: option.values;
                    selected: option.selected;
                    chosen(index) => { root.set-option(option.id, option.values[index]); }
                }
                if option.kind == "int" : Stepper {
                    x: parent.width - self.width - 24px; y: 8px;
                    label: option.label;
                    value: option.number;
                    can-decrease: option.number > option.min;
                    can-increase: option.number < option.max;
                    stepped(delta) => { root.set-option(option.id, (option.number + delta) + ""); }
                }
                if option.kind == "choice" && option.values.length > 4 : Stepper {
                    x: parent.width - self.width - 24px; y: 8px;
                    label: option.label;
                    value: option.text;
                    stepped(delta) => {
                        root.set-option(option.id, option.values[Math.mod(option.selected + delta + option.values.length, option.values.length)]);
                    }
                }
                if option.kind == "color" : Swatches {
                    x: parent.width - self.width - 24px; y: 8px;
                    options: option.swatches;
                    selected: option.color;
                    label: option.label;
                    chosen(text) => { root.set-option(option.id, text); }
                }
            }
        }
        if !root.options-open && root.theme-options.length > 0 && root.theme-selection == root.active-theme : PillButton {
            x: parent.width - 496px; y: parent.body-height - self.height;
            label: "Customize";
            primary: false;
            pressed => { root.options-open = true; }
        }
        if !root.options-open : PillButton {
            x: parent.width - self.width; y: parent.body-height - self.height;
            label: "Apply";
            enabled: root.theme-selection != "" && root.theme-selection != root.active-theme;
            pressed => { root.apply-theme(root.theme-selection); }
        }
        if root.options-open : PillButton {
            x: parent.width - self.width; y: parent.body-height - self.height;
            label: "Back";
            primary: false;
            pressed => { root.options-open = false; }
        }
    }
    if root.pane == "Plugins" : Pane {
        x: 432px; y: 88px; width: root.width - 640px; height: root.height - 248px;
        title: "Plugins";
        Flickable {
            x: 0px; y: 0px; width: parent.width; height: parent.body-height;
            content-width: self.width;
            content-height: max(self.height, root.plugins.length * 96px - 16px);
            if root.plugins.length == 0 : HostText {
                x: 0px; y: 0px; width: parent.width; height: 32px;
                text: "No plugins installed";
                color: LockConfig.style.muted;
                font-size: 22px;
            }
            for plugin[i] in root.plugins : Rectangle {
                x: 0px; y: i * 96px; width: parent.width; height: 80px;
                clip: true;
                border-radius: 24px;
                border-width: 1px;
                border-color: LockConfig.style.key-border;
                background: LockConfig.style.key-background;
                HostText {
                    x: 24px; y: 8px; width: parent.width - 272px; height: 32px;
                    text: plugin.label;
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    overflow: elide;
                }
                HostText {
                    x: 24px; y: 44px; width: parent.width - 272px; height: 24px;
                    text: plugin.slots;
                    color: LockConfig.style.muted;
                    font-size: 18px;
                    overflow: elide;
                }
                Choice {
                    x: parent.width - 224px; y: (parent.height - self.height) / 2;
                    width: 200px;
                    options: ["Off", "On"];
                    selected: plugin.enabled ? 1 : 0;
                    chosen(index) => { root.set-plugin(plugin.package, index == 1); }
                }
            }
        }
    }
    if root.pane == "About" : Pane {
        x: 432px; y: 88px; width: root.width - 640px; height: root.height - 248px;
        title: "About";
        VerticalLayout {
            alignment: start;
            spacing: 24px;
            HostText {
                text: "Host version  " + HostState.version-text;
                color: LockConfig.style.foreground;
                font-size: 22px;
            }
            HostText {
                text: "Contract version  " + Vehicle.contract-version;
                color: LockConfig.style.foreground;
                font-size: 22px;
            }
        }
    }
    HostText {
        x: 432px; y: root.height - 120px; width: root.width - 536px; height: 40px;
        text: (HostState.clock-text == "" ? "--" : HostState.clock-text) + " · "
            + (HostState.battery-pct < 0 ? "--" : HostState.battery-pct + "%");
        color: LockConfig.style.muted;
        font-size: 18px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}
