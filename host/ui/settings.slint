import { Vehicle } from "vehicle.slint";
import { HostState } from "overlay.slint";
import { LockConfig } from "unlock.slint";
import { HostText } from "hosttext.slint";
import { RailRow, CloseButton, Pane, Choice, PillButton } from "kit.slint";
import { ThemeInfo } from "theme-switch.slint";

export struct PluginInfo {
    package: string,
    label: string,
    slots: string,
    enabled: bool,
}

// Interactive host screen: parked only, enforced by Host in theme_root.rs.
export component SettingsScreen inherits Rectangle {
    callback closed();
    callback set-setting(string, string);
    callback apply-theme(string);
    callback load-plugins();
    callback set-plugin(string, bool);
    in property <[ThemeInfo]> themes;
    in property <[PluginInfo]> plugins;
    in property <string> active-theme;
    in property <bool> clock24: true;
    in-out property <int> selected: 0;
    property <[string]> panes: ["Display", "Theme", "Plugins", "About"];
    property <string> pane: panes[selected];
    in-out property <int> cursor: 0;
    property <string> theme-selection;
    init => {
        root.cursor = root.selected;
        root.theme-selection = root.active-theme;
        if root.pane == "Plugins" { root.load-plugins(); }
    }
    changed selected => {
        if root.pane == "Theme" { root.theme-selection = root.active-theme; }
        if root.pane == "Plugins" { root.load-plugins(); }
    }
    public function move(delta: int) {
        root.cursor = max(0, min(root.panes.length - 1, root.cursor + delta));
    }
    public function select() {
        root.selected = root.cursor;
    }
    public function close() { root.closed(); }
    background: LockConfig.style.background;
    TouchArea { }

    Rectangle {
        x: 104px; y: 80px; width: 280px; height: root.height - 160px;
        border-radius: 24px;
        border-width: 1px;
        border-color: LockConfig.style.key-border;
        background: LockConfig.style.key-background;
        for entry[i] in root.panes : RailRow {
            x: 16px; y: 16px + i * 88px; width: parent.width - 32px;
            label: entry;
            selected: root.pane == entry;
            pressed => { root.cursor = i; root.select(); }
        }
    }
    CloseButton {
        x: root.width - 168px; y: 80px;
        pressed => { root.close(); }
    }
    if root.pane == "Display" : Pane {
        x: 432px; y: 88px; width: root.width - 640px; height: root.height - 248px;
        title: "Display";
        VerticalLayout {
            alignment: start;
            spacing: 32px;
            HorizontalLayout {
                spacing: 24px;
                HostText {
                    text: "Night mode";
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Choice {
                    width: 360px;
                    options: ["Off", "On"];
                    selected: HostState.night ? 1 : 0;
                    chosen(index) => { root.set-setting("night", index == 0 ? "off" : "on"); }
                }
            }
            HorizontalLayout {
                spacing: 24px;
                HostText {
                    text: "Clock";
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Choice {
                    width: 360px;
                    options: ["24-hour", "12-hour"];
                    selected: root.clock24 ? 0 : 1;
                    chosen(index) => { root.set-setting("clock24", index == 0 ? "true" : "false"); }
                }
            }
        }
    }
    if root.pane == "Theme" : Pane {
        x: 432px; y: 88px; width: root.width - 640px; height: root.height - 248px;
        title: "Theme";
        Flickable {
            x: 0px; y: 0px; width: parent.width; height: parent.body-height - 88px;
            content-width: self.width;
            content-height: max(self.height, root.themes.length * 96px - 16px);
            for theme[i] in root.themes : Rectangle {
                x: 0px; y: i * 96px; width: parent.width; height: 80px;
                border-radius: 24px;
                border-width: 1px;
                border-color: LockConfig.style.key-border;
                property <bool> selected: root.theme-selection == theme.id;
                property <color> ink: self.selected ? LockConfig.on-accent : LockConfig.style.foreground;
                property <color> secondary: self.selected ? LockConfig.on-accent : LockConfig.style.muted;
                property <length> text-width: self.width - (theme.id == root.active-theme ? 152px : 48px);
                background: self.selected ? LockConfig.style.accent : LockConfig.style.key-background;
                accessible-role: button;
                accessible-label: theme.name;
                accessible-checkable: true;
                accessible-checked: self.selected;
                accessible-action-default => { root.theme-selection = theme.id; }
                HostText {
                    x: 24px; y: 8px; width: parent.text-width; height: 32px;
                    text: theme.name;
                    color: parent.ink;
                    font-size: 26px;
                    font-weight: 700;
                    overflow: elide;
                }
                HostText {
                    x: 24px; y: 44px; width: parent.text-width; height: 24px;
                    text: theme.description;
                    color: parent.secondary;
                    font-size: 18px;
                    overflow: elide;
                }
                if theme.id == root.active-theme : HostText {
                    x: parent.width - 120px; width: 96px; height: parent.height;
                    text: "In use";
                    color: parent.secondary;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                TouchArea { clicked => { root.theme-selection = theme.id; } }
            }
        }
        PillButton {
            x: parent.width - self.width; y: parent.body-height - self.height;
            label: "Apply";
            enabled: root.theme-selection != "" && root.theme-selection != root.active-theme;
            pressed => { root.apply-theme(root.theme-selection); }
        }
    }
    if root.pane == "Plugins" : Pane {
        x: 432px; y: 88px; width: root.width - 640px; height: root.height - 248px;
        title: "Plugins";
        Flickable {
            x: 0px; y: 0px; width: parent.width; height: parent.body-height;
            content-width: self.width;
            content-height: max(self.height, root.plugins.length * 96px - 16px);
            if root.plugins.length == 0 : HostText {
                x: 0px; y: 0px; width: parent.width; height: 32px;
                text: "No plugins installed";
                color: LockConfig.style.muted;
                font-size: 22px;
            }
            for plugin[i] in root.plugins : Rectangle {
                x: 0px; y: i * 96px; width: parent.width; height: 80px;
                clip: true;
                border-radius: 24px;
                border-width: 1px;
                border-color: LockConfig.style.key-border;
                background: LockConfig.style.key-background;
                HostText {
                    x: 24px; y: 8px; width: parent.width - 272px; height: 32px;
                    text: plugin.label;
                    color: LockConfig.style.foreground;
                    font-size: 26px;
                    font-weight: 700;
                    overflow: elide;
                }
                HostText {
                    x: 24px; y: 44px; width: parent.width - 272px; height: 24px;
                    text: plugin.slots;
                    color: LockConfig.style.muted;
                    font-size: 18px;
                    overflow: elide;
                }
                Choice {
                    x: parent.width - 224px; y: (parent.height - self.height) / 2;
                    width: 200px;
                    options: ["Off", "On"];
                    selected: plugin.enabled ? 1 : 0;
                    chosen(index) => { root.set-plugin(plugin.package, index == 1); }
                }
            }
        }
    }
    if root.pane == "About" : Pane {
        x: 432px; y: 88px; width: root.width - 640px; height: root.height - 248px;
        title: "About";
        VerticalLayout {
            alignment: start;
            spacing: 24px;
            HostText {
                text: "Host version  " + HostState.version-text;
                color: LockConfig.style.foreground;
                font-size: 22px;
            }
            HostText {
                text: "Contract version  " + Vehicle.contract-version;
                color: LockConfig.style.foreground;
                font-size: 22px;
            }
        }
    }
    HostText {
        x: 432px; y: root.height - 120px; width: root.width - 536px; height: 40px;
        text: (HostState.clock-text == "" ? "--" : HostState.clock-text) + " · "
            + (HostState.battery-pct < 0 ? "--" : HostState.battery-pct + "%");
        color: LockConfig.style.muted;
        font-size: 18px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
}
