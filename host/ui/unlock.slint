// Host-only lock screen. The host draws every element and handles every key press.
// A theme supplies only style data (`lock-style`, contract v6): colours, key shape and
// digit drawing. The host writes that into LockConfig after checking it (host/src/theme_root.rs).
// Layout, key order, labels, copy and phase logic are fixed here. PIN digits stay in Java;
// Slint receives only their count. Sizes and defaults: docs/design/host-ui-tokens.md.
import { LockKeyShape, LockDigits, LockStyle } from "vehicle.slint";
import { LockSegDigit } from "segdigit.slint";
import { HostText } from "hosttext.slint";

// Written by the host from the theme's optional lock-style, or the host defaults for the
// current mode (theme_root.rs HOST_LOCK_DAY, HOST_LOCK_NIGHT; the values below are the day
// defaults). `error` is the error copy colour and `on-accent` the text colour on an accent
// fill; the host picks both so they read on the colour behind them.
export global LockConfig {
    in property <LockStyle> style: {
        background: #f6f3ec,
        foreground: #0f2a2a,
        muted: #4a5c5c,
        accent: #ffc94a,
        key-background: #ffffff,
        key-border: #d9d2c3,
        key-shape: LockKeyShape.rounded,
        digits: LockDigits.sans,
    };
    in property <color> error: #a33a00;
    in property <color> on-accent: #0f2a2a;
}

// One keypad key. `digit` 0-9 draws the digit in segment style when the theme asks for it.
// `strong` fills the key with the accent (Delete); `quiet` has no fill (Clear).
component Key inherits Rectangle {
    in property <string> label;
    in property <int> digit: -1;
    in property <bool> enabled: true;
    in property <bool> strong;
    in property <bool> quiet;
    callback pressed();
    property <bool> grid: LockConfig.style.key-shape == LockKeyShape.grid;
    property <color> ink: root.strong ? LockConfig.on-accent : root.quiet && !root.grid ? LockConfig.style.muted : LockConfig.style.foreground;
    property <color> fill: root.strong ? LockConfig.style.accent
        : root.quiet && !root.grid ? transparent
        : LockConfig.style.key-background;
    border-radius: LockConfig.style.key-shape == LockKeyShape.rounded ? 18px
        : LockConfig.style.key-shape == LockKeyShape.square ? 4px : 0px;
    border-width: root.grid || root.quiet || root.strong ? 0px : 1px;
    border-color: LockConfig.style.key-border;
    // Disabled keys fade toward the screen; pressed keys lean toward the text colour.
    background: !root.enabled ? (root.quiet && !root.grid ? transparent : root.fill.mix(LockConfig.style.background, 0.5))
        : touch.pressed ? root.fill.mix(root.ink, 0.15)
        : root.fill;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.pressed(); } }

    if LockConfig.style.digits == LockDigits.segment && root.digit >= 0 : LockSegDigit {
        width: 36px;
        height: 64px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        digit: root.digit;
        ink: root.enabled ? root.ink : root.ink.with-alpha(0.4);
    }
    if !(LockConfig.style.digits == LockDigits.segment && root.digit >= 0) : HostText {
        text: root.label;
        color: root.enabled ? root.ink : root.ink.with-alpha(0.4);
        font-size: root.digit >= 0 ? 44px : 26px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.pressed(); }
    }
}

export component UnlockScreen inherits Rectangle {
    in property <int> phase;
    in property <int> pin-length;
    in property <int> attempts: -1;
    in property <int> error;
    in property <int> cooldown;
    in property <bool> available;
    in property <bool> test-mode;
    // Left column, from the host's own vehicle values.
    in property <string> clock-text;
    in property <string> date-text;
    in property <int> battery-pct: -1;
    callback key(int);

    property <bool> grid: LockConfig.style.key-shape == LockKeyShape.grid;
    property <bool> segment: LockConfig.style.digits == LockDigits.segment;
    property <bool> square-cells: LockConfig.style.key-shape == LockKeyShape.square;
    property <bool> entering: root.phase == 1 || root.phase == 2;
    // Clock as hhmm (10:24 is 1024) for the segment digits; -1 = ghost only.
    property <int> clock-val: root.clock-text == "" ? -1 : round(root.clock-text.replace-all(":", "").to-float());
    property <int> pct: root.battery-pct > 100 ? 100 : root.battery-pct;
    // Right column: 596 px wide, 104 px from the edge (clear of a 72 px side strip); the left
    // column is the 444 px before it. HostOverlay draws the alert footer in the left column.
    property <length> kx: root.width - 104px - 596px;
    property <length> gap: root.grid ? 1px : 16px;
    property <string> left: root.attempts + (root.attempts == 1 ? " attempt" : " attempts") + " remaining";
    // The line under the caption: empty in the normal state until attempts are known.
    property <string> line: root.phase == 0 ? (root.error == 2 ? "Cannot reach the passcode service, retry the connection" : "Waiting for vehicle status")
        : root.phase == 3 ? "Waiting for the scooter to confirm unlock"
        : root.phase == 2 ? (root.error == 2 ? "Verification is taking longer than expected, please wait" : "Please wait")
        : root.test-mode ? "Exit test mode before unlocking"
        : root.attempts == 0 ? ""
        : root.error == 1 ? "Incorrect passcode" + (root.attempts > 0 ? ", " + root.left : "")
        : root.error == 2 ? "Passcode service unavailable, retry the connection"
        : root.error == 3 ? "Unlock was not confirmed, check the scooter and retry"
        : root.attempts > 0 ? root.left : "";
    property <bool> failed: root.phase == 1 && root.error != 0 && root.attempts != 0 && !root.test-mode;

    background: LockConfig.style.background;

    // Block theme interaction whenever authentication or PARK is in front.
    TouchArea { }

    // ---- left column: clock, date, battery (the strip carries lock and charging) ----
    if !root.segment : HostText {
        x: 104px; y: 60px; width: 444px; height: 144px;
        text: root.clock-text == "" ? "--:--" : root.clock-text;
        color: LockConfig.style.foreground;
        font-size: 120px;
        font-weight: 800;
        vertical-alignment: center;
    }
    if root.segment : Rectangle {
        x: 104px; y: 76px; width: 268px; height: 112px;
        background: transparent;
        LockSegDigit {
            x: 0px; width: 56px; height: 112px; ink: LockConfig.style.foreground;
            digit: root.clock-val < 0 ? -1 : Math.mod(floor(root.clock-val / 1000), 10);
        }
        LockSegDigit {
            x: 64px; width: 56px; height: 112px; ink: LockConfig.style.foreground;
            digit: root.clock-val < 0 ? -1 : Math.mod(floor(root.clock-val / 100), 10);
        }
        Rectangle { x: 130px; y: 36px; width: 10px; height: 10px; background: LockConfig.style.foreground; }
        Rectangle { x: 130px; y: 66px; width: 10px; height: 10px; background: LockConfig.style.foreground; }
        LockSegDigit {
            x: 148px; width: 56px; height: 112px; ink: LockConfig.style.foreground;
            digit: root.clock-val < 0 ? -1 : Math.mod(floor(root.clock-val / 10), 10);
        }
        LockSegDigit {
            x: 212px; width: 56px; height: 112px; ink: LockConfig.style.foreground;
            digit: root.clock-val < 0 ? -1 : Math.mod(root.clock-val, 10);
        }
    }
    HostText {
        x: 104px; y: 208px; width: 444px; height: 32px;
        text: root.date-text;
        color: LockConfig.style.muted;
        font-size: 22px;
        vertical-alignment: center;
    }
    if !root.segment : HostText {
        x: 104px; y: 256px; width: 240px; height: 56px;
        text: root.battery-pct < 0 ? "--" : root.battery-pct + "%";
        color: LockConfig.style.foreground;
        font-size: 44px;
        font-weight: 700;
        vertical-alignment: center;
    }
    if root.segment : Rectangle {
        x: 104px; y: 264px; width: 240px; height: 40px;
        background: transparent;
        LockSegDigit {
            x: 0px; width: 22px; height: 40px; ink: LockConfig.style.foreground;
            digit: root.pct >= 100 ? 1 : -1;
        }
        LockSegDigit {
            x: 26px; width: 22px; height: 40px; ink: LockConfig.style.foreground;
            digit: root.pct >= 10 ? Math.mod(floor(root.pct / 10), 10) : -1;
        }
        LockSegDigit {
            x: 52px; width: 22px; height: 40px; ink: LockConfig.style.foreground;
            digit: root.pct < 0 ? -1 : Math.mod(root.pct, 10);
        }
        HostText {
            x: 80px; y: 0px; width: 40px; height: 40px;
            text: root.pct < 0 ? "--" : "%";
            color: LockConfig.style.foreground;
            font-size: 26px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    // ---- right column: caption, hint or status, passcode cells, keypad ----
    HostText {
        x: root.kx; y: 60px; width: 596px; height: 48px;
        text: root.phase == 0 ? (root.error == 2 ? "Connection unavailable" : "Connecting")
            : root.phase == 3 ? "Unlocking"
            : root.phase == 2 ? "Checking passcode"
            : root.attempts == 0 ? (root.cooldown > 0 ? "Try again in " + root.cooldown + " s" : "Try again shortly")
            : "Enter your scooter passcode";
        color: LockConfig.style.foreground;
        font-size: 40px;
        font-weight: 800;
        overflow: elide;
        vertical-alignment: center;
    }

    HostText {
        x: root.kx; y: 112px; width: 596px; height: 56px;
        text: root.line;
        color: root.failed ? LockConfig.error : LockConfig.style.muted;
        font-size: 22px;
        wrap: word-wrap;
        overflow: elide;
    }

    // Passcode cells: a dot per digit entered. Square when the keys are.
    if root.entering : HorizontalLayout {
        x: root.kx; y: 176px; width: 596px; height: 64px;
        spacing: 16px;
        for i in 6 : Rectangle {
            border-radius: root.square-cells ? 4px : 18px;
            border-width: 1px;
            border-color: LockConfig.style.key-border;
            background: LockConfig.style.key-background;
            if i < root.pin-length : Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 24px; height: 24px;
                border-radius: 12px;
                background: LockConfig.style.foreground;
            }
        }
    }

    // Keypad: 3 x 4 keys in a fixed 596 x 432 block. Grid keys share 1 px hairlines.
    if root.entering : Rectangle {
        x: root.kx; y: 256px; width: 596px; height: 432px;
        background: root.grid ? LockConfig.style.key-border : transparent;
        VerticalLayout {
            spacing: root.gap;
            for row in 3 : HorizontalLayout {
                spacing: root.gap;
                for col in 3 : Key {
                    label: "" + (row * 3 + col + 1);
                    digit: row * 3 + col + 1;
                    enabled: root.available && !root.test-mode;
                    pressed => { root.key(row * 3 + col + 1); }
                }
            }
            HorizontalLayout {
                spacing: root.gap;
                Key { label: "Clear"; quiet: true; enabled: root.available; pressed => { root.key(11); } }
                Key { label: "0"; digit: 0; enabled: root.available; pressed => { root.key(0); } }
                Key { label: "Delete"; strong: true; enabled: root.available; pressed => { root.key(10); } }
            }
        }
    }

    if (root.phase == 0 || root.phase == 1) && root.error == 2 : Key {
        x: 104px; y: 360px; width: 300px; height: 96px;
        label: "Retry connection";
        pressed => { root.key(12); }
    }
}
