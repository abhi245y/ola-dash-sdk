// Drawing helpers for the default theme. Pure geometry: no globals, no state.
// Coordinates are absolute window pixels; each element covers the whole window.

// Clockwise arc on a circle, starting at the lower-left (135 deg, y-down) and
// sweeping up to 270 deg. `fraction` is 0..1 of that sweep.
export component Arc inherits Path {
    in property <float> cx: 0;
    in property <float> cy: 0;
    in property <float> radius: 100;
    in property <float> fraction: 0;

    x: 0px;
    y: 0px;
    width: 1280px;
    height: 768px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 1280;
    viewbox-height: 768;
    fill: transparent;
    visible: fraction > 0.003;

    property <float> a0: 135;
    property <float> a1: 135 + 270 * fraction;
    commands: "M " + (cx + radius * Math.cos(a0 * 1deg)) + " " + (cy + radius * Math.sin(a0 * 1deg))
        + " A " + radius + " " + radius + " 0 " + (fraction > 0.667 ? "1" : "0") + " 1 "
        + (cx + radius * Math.cos(a1 * 1deg)) + " " + (cy + radius * Math.sin(a1 * 1deg));
}

// Speed scale ticks around the main gauge (centre 330, 356; radius 226). Every 10 km/h,
// longer every 20. Static geometry for a 0..120 km/h scale; labels are placed in main.slint.
export component GaugeTicks inherits Path {
    x: 0px;
    y: 0px;
    width: 1280px;
    height: 768px;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 1280;
    viewbox-height: 768;
    fill: transparent;
    stroke: #3a4658;
    stroke-width: 3px;
    commands: "M 160.3 525.7 L 149.0 537.0 M 104.6 449.4 L 95.3 453.2 M 90.0 356.0 L 74.0 356.0 M 104.6 262.6 L 95.3 258.8 M 160.3 186.3 L 149.0 175.0 M 236.6 130.6 L 232.8 121.3 M 330.0 116.0 L 330.0 100.0 M 423.4 130.6 L 427.2 121.3 M 499.7 186.3 L 511.0 175.0 M 555.4 262.6 L 564.7 258.8 M 570.0 356.0 L 586.0 356.0 M 555.4 449.4 L 564.7 453.2 M 499.7 525.7 L 511.0 537.0";
}
