// Must fail: this font claims the host's family name, so fontique would merge it into the
// host font's family and could serve its one-glyph face for host text.
import "fonts/OlaDashHost-Medium.ttf";
import { Vehicle } from "vehicle.slint";
export { Vehicle }
export component Dash inherits Window {
    width: 1280px; height: 768px; background: #000;
    default-font-family: "OlaDash Host";
}
